{
  "name": "virtbase",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Janic Bellmann <contact@janic.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/virtbase/virtbase"
  },
  "bugs": {
    "url": "https://github.com/virtbase/virtbase/issues"
  },
  "homepage": "https://virtbase.com",
  "keywords": [
    "vps",
    "cloud",
    "hosting"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:boundaries": "bun node_modules/dependency-cruiser/bin/dependency-cruise.mjs packages apps --config .dependency-cruiser.jsonc --output-type err",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "cluster:down": "docker compose -f tooling/proxmox-cluster/docker-compose.yml down",
    "cluster:reset": "./tooling/proxmox-cluster/reset.sh",
    "cluster:up": "docker compose -f tooling/proxmox-cluster/docker-compose.yml up -d --build && ./tooling/proxmox-cluster/bootstrap.sh",
    "db:generate": "turbo -F @virtbase/db db:generate",
    "db:migrate": "turbo -F @virtbase/db db:migrate",
    "db:push": "turbo -F @virtbase/db db:push",
    "db:studio": "turbo -F @virtbase/db db:studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @virtbase/web...",
    "discord:register-commands": "turbo -F @virtbase/integration-discord register-commands",
    "discord:register-connections-metadata": "turbo -F @virtbase/integration-discord register-connections-metadata",
    "email": "turbo run email",
    "eval:firewall-ai": "bun --env-file .env packages/api/src/firewall-ai/eval/run.ts",
    "prepare": "husky",
    "script": "turbo -F @virtbase/web script --",
    "setup": "./scripts/setup.sh",
    "setup:cluster": "./scripts/setup.sh --cluster",
    "stripe:listen": "turbo -F @virtbase/web stripe:listen",
    "test": "turbo run test",
    "test:coverage": "turbo run test --force -- --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:e2e": "turbo -F @virtbase/web test:e2e",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "catalog": {
    "@better-auth/api-key": "^1.7.0-rc.4",
    "@better-auth/passkey": "^1.7.0-rc.4",
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "better-auth": "^1.7.0-rc.4",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "nuqs": "^2.9.5",
    "postcss": "^8.5.25",
    "proxmox-api": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "use-intl": "^4.13.5",
    "workflow": "^4.8.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "catalogs": {
    "sentry": {
      "@sentry/core": "10.69.0",
      "@sentry/nextjs": "10.69.0",
      "@sentry/node": "10.69.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "catalog:",
    "dependency-cruiser": "^18.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.8"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "patchedDependencies": {
    "@ai-sdk/provider-utils@5.0.23": "patches/@ai-sdk-provider-utils@5.0.23.patch",
    "proxmox-api@1.1.1": "patches/proxmox-api@1.1.1.patch"
  }
}
