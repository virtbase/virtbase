{
  "name": "virtbase",
  "author": "Janic Bellmann <contact@janic.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/virtbase/virtbase"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "catalog:",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "turbo": "^2.10.12"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "bugs": {
    "url": "https://github.com/virtbase/virtbase/issues"
  },
  "catalog": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@types/bun": "1.4.2",
    "@virtbase/proxmox-api": "^2.0.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "typescript": "^7.0.2",
    "workflow": "^4.8.6",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "catalogs": {
    "auth": {
      "@better-auth/api-key": "^1.7.3",
      "@better-auth/passkey": "^1.7.3",
      "better-auth": "^1.7.3"
    },
    "intl": {
      "next-intl": "^4.14.2",
      "use-intl": "^4.14.2"
    },
    "react": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "react": "^19.2.8",
      "react-dom": "^19.2.8"
    },
    "sentry": {
      "@sentry/core": "10.73.0",
      "@sentry/nextjs": "10.73.0",
      "@sentry/node": "10.73.0"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.3.3",
      "postcss": "^8.5.28",
      "tailwindcss": "^4.3.3"
    },
    "trpc": {
      "@trpc/client": "^11.18.0",
      "@trpc/server": "^11.18.0",
      "@trpc/tanstack-react-query": "^11.18.0"
    }
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.15.0"
  },
  "homepage": "https://virtbase.com",
  "keywords": [
    "vps",
    "cloud",
    "hosting"
  ],
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "undici@>=7.0.0 <7.29.0": "7.29.0",
    "nanoid@>=4.0.0 <5.1.16": "5.1.16",
    "next@<16.2.11": "16.3.4",
    "esbuild@>=0.27.3 <0.28.1": "0.28.2",
    "@ai-sdk/provider-utils@>=4.0.0-beta.10 <4.0.33": "4.0.33"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@ai-sdk/provider-utils@5.0.37": "patches/@ai-sdk%2Fprovider-utils@5.0.37.patch"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:boundaries": "bun node_modules/dependency-cruiser/bin/dependency-cruise.mjs packages apps --config .dependency-cruiser.jsonc --output-type err",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "cluster:down": "docker compose -f tooling/proxmox-cluster/docker-compose.yml down",
    "cluster:reset": "./tooling/proxmox-cluster/reset.sh",
    "cluster:up": "docker compose -f tooling/proxmox-cluster/docker-compose.yml up -d --build && ./tooling/proxmox-cluster/bootstrap.sh",
    "db:generate": "turbo -F @virtbase/db db:generate",
    "db:migrate": "turbo -F @virtbase/db db:migrate",
    "db:push": "turbo -F @virtbase/db db:push",
    "db:studio": "turbo -F @virtbase/db db:studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @virtbase/web...",
    "discord:emojis": "turbo -F @virtbase/integration-discord rasterize-emojis",
    "discord:tunnel": "bunx localtunnel --port 3000 --subdomain virtbase-dev --print-requests",
    "email": "turbo run email",
    "eval:firewall-ai": "bun --env-file .env packages/api/src/firewall-ai/eval/run.ts",
    "prepare": "husky",
    "script": "turbo -F @virtbase/web script --",
    "setup": "./scripts/setup.sh",
    "setup:cluster": "./scripts/setup.sh --cluster",
    "stripe:listen": "turbo -F @virtbase/web stripe:listen",
    "test": "turbo run test",
    "test:coverage": "turbo run test --force -- --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:e2e": "turbo -F @virtbase/web test:e2e",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
