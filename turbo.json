{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#check": {},
    "//#check:boundaries": {},
    "test": {
      "dependsOn": ["^topo"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!e2e/**", "$TURBO_ROOT$/.env.test"]
    },
    "test:e2e": {
      "dependsOn": ["^topo"],
      "cache": false,
      "passThroughEnv": ["PORT", "VERCEL_AUTOMATION_BYPASS_SECRET"],
      "outputs": ["playwright-report/**", "test-results/**", "blob-report/**"]
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    },
    "email": {
      "cache": false,
      "persistent": true
    },
    "script": {
      "cache": false,
      "persistent": true
    },
    "stripe:listen": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_REF",
    "SENTRY_AUTH_TOKEN",
    "npm_lifecycle_event",
    "E2E_PUBLIC_URL",
    "E2E_APP_URL",
    "E2E_ADMIN_URL",
    "E2E_PORT",
    "E2E_SKIP_WEB_SERVER",
    "NODE_EXTRA_CA_CERTS",
    "NEXT_RUNTIME"
  ]
}
