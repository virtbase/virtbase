{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "ui": "tui",
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_ACTIONS",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_SHA",
    "NODE_ENV",
    "VERCEL_GIT_COMMIT_REF",
    "SENTRY_AUTH_TOKEN",
    "npm_lifecycle_event",
    "E2E_PUBLIC_URL",
    "E2E_APP_URL",
    "E2E_ADMIN_URL",
    "E2E_PORT",
    "E2E_SKIP_WEB_SERVER",
    "NODE_EXTRA_CA_CERTS",
    "NEXT_RUNTIME"
  ],
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true,
    "longerSignatureKey": true
  },
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "AI_GATEWAY_API_KEY",
        "NEXT_PUBLIC_APP_NAME",
        "NEXT_PUBLIC_APP_DOMAIN",
        "BETTER_AUTH_SECRET",
        "CONFIG_ENCRYPTION_KEY",
        "DATABASE_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "ABUSE_MAILBOX_DOMAIN",
        "ABUSE_MAILBOX_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "STRIPE_SECRET_KEY",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_ANONPAY_METHOD_ID",
        "ANONPAY_TICKER_TO",
        "ANONPAY_NETWORK_TO",
        "ANONPAY_ADDRESS",
        "ANONPAY_WEBHOOK_SECRET",
        "CRON_SECRET",
        "NOVNC_PROXY_URL",
        "NOVNC_PROXY_SECRET",
        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_CSP_REPORT_URI",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_URL",
        "NEXT_PUBLIC_VERCEL_ENV"
      ]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^topo", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!e2e/**", "$TURBO_ROOT$/.env.test"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["^topo"],
      "passThroughEnv": ["PORT", "VERCEL_AUTOMATION_BYPASS_SECRET"],
      "outputs": ["playwright-report/**", "test-results/**", "blob-report/**"],
      "cache": false
    },
    "publint": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "//#check": {},
    "db:generate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "email": {
      "cache": false,
      "persistent": true
    },
    "script": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "stripe:listen": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  },
  "boundaries": {
    "tags": {
      "foundation": {
        "dependencies": {
          "allow": ["foundation", "tooling"]
        }
      },
      "ports": {
        "dependencies": {
          "allow": ["foundation", "tooling"]
        }
      },
      "platform": {
        "dependencies": {
          "allow": ["foundation", "platform", "testing", "tooling"]
        }
      },
      "sdk": {
        "dependencies": {
          "allow": ["foundation", "ports", "tooling"]
        }
      },
      "integration": {
        "dependencies": {
          "allow": ["foundation", "ports", "sdk", "platform", "tooling"]
        },
        "dependents": {
          "allow": ["api", "app"]
        }
      },
      "api": {
        "dependencies": {
          "allow": [
            "foundation",
            "ports",
            "platform",
            "sdk",
            "integration",
            "tooling"
          ]
        },
        "dependents": {
          "allow": ["app"]
        }
      },
      "testing": {
        "dependencies": {
          "allow": ["foundation", "tooling"]
        }
      },
      "content": {
        "dependencies": {
          "allow": ["tooling"]
        },
        "dependents": {
          "allow": ["app"]
        }
      },
      "app": {
        "dependents": {
          "allow": []
        }
      },
      "tooling": {
        "dependencies": {
          "allow": ["tooling"]
        }
      }
    }
  }
}
