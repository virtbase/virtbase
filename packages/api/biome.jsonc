{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "suspicious": {
        // This package breaks its own import cycles with dynamic `import()`,
        // which is the documented convention here - see the rationale in
        // `src/integrations/server-management.ts`. A deferred import cannot
        // produce the "cannot access before initialization" failures the rule
        // guards against, but Biome still counts it as a graph edge, so all 50
        // loops in this package report despite being safe: every one is closed
        // by a dynamic or type-only edge, and none is static end to end.
        //
        // Annotating the 42 files involved would be noise over correct code.
        // The rule stays on everywhere else, where it earns its keep - it is
        // what surfaced the login-form context cycle in `apps/web`.
        "noImportCycles": "off"
      }
    }
  }
}
