{
  "name": "@virtbase/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "default": "./src/integrations/index.ts"
    },
    "./orders": {
      "types": "./dist/orders.d.ts",
      "default": "./src/orders/index.ts"
    },
    "./proxmox": {
      "types": "./dist/proxmox.d.ts",
      "default": "./src/proxmox/index.ts"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./src/workflows/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "bun --env-file ../../.env --"
  },
  "dependencies": {
    "@sentry/node": "catalog:sentry",
    "@trpc/server": "catalog:",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@virtbase/auth": "workspace:*",
    "@virtbase/config": "workspace:*",
    "@virtbase/db": "workspace:*",
    "@virtbase/email": "workspace:*",
    "@virtbase/integration-anonpay": "workspace:*",
    "@virtbase/integration-discord": "workspace:*",
    "@virtbase/integration-lexware": "workspace:*",
    "@virtbase/integration-powerdns": "workspace:*",
    "@virtbase/integration-sdk": "workspace:*",
    "@virtbase/integration-stripe": "workspace:*",
    "@virtbase/ports": "workspace:*",
    "@virtbase/utils": "workspace:*",
    "@virtbase/validators": "workspace:*",
    "ai": "7.0.55",
    "proxmox-api": "catalog:",
    "server-only": "^0.0.1",
    "superjson": "catalog:",
    "trpc-to-openapi": "^3.3.0",
    "use-intl": "catalog:",
    "workflow": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "next": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@virtbase/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
