{
  "name": "@virtbase/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./cloud-init": {
      "types": "./dist/cloud-init/index.d.ts",
      "default": "./src/cloud-init/index.ts"
    },
    "./backups": {
      "types": "./dist/backups.d.ts",
      "default": "./src/backups/index.ts"
    },
    "./guest-os": {
      "types": "./dist/guest-os/index.d.ts",
      "default": "./src/guest-os/index.ts"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "default": "./src/integrations/index.ts"
    },
    "./orders": {
      "types": "./dist/orders.d.ts",
      "default": "./src/orders/index.ts"
    },
    "./privacy": {
      "types": "./dist/privacy/index.d.ts",
      "default": "./src/privacy/index.ts"
    },
    "./proxmox": {
      "types": "./dist/proxmox.d.ts",
      "default": "./src/proxmox/index.ts"
    },
    "./template-images": {
      "types": "./dist/template-images/index.d.ts",
      "default": "./src/template-images/index.ts"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./src/workflows/index.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/fixtures": {
      "types": "./dist/testing/fixtures.d.ts",
      "default": "./src/testing/fixtures.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "embed-fonts": "bun scripts/embed-fonts.ts",
    "dev": "tsc",
    "test": "bun --env-file=../../.env.test test --timeout 20000",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "bun --env-file ../../.env --"
  },
  "dependencies": {
    "@sentry/node": "catalog:sentry",
    "@trpc/server": "catalog:",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@virtbase/auth": "workspace:*",
    "@virtbase/config": "workspace:*",
    "@virtbase/db": "workspace:*",
    "@virtbase/email": "workspace:*",
    "@virtbase/integration-anonpay": "workspace:*",
    "@virtbase/integration-discord": "workspace:*",
    "@virtbase/integration-lexware": "workspace:*",
    "@virtbase/integration-powerdns": "workspace:*",
    "@virtbase/integration-prometheus": "workspace:*",
    "@virtbase/integration-sdk": "workspace:*",
    "@virtbase/integration-stripe": "workspace:*",
    "@virtbase/ports": "workspace:*",
    "@virtbase/utils": "workspace:*",
    "@virtbase/validators": "workspace:*",
    "ai": "7.0.55",
    "pdfkit": "^0.19.1",
    "proxmox-api": "catalog:",
    "server-only": "^0.0.1",
    "superjson": "catalog:",
    "trpc-to-openapi": "^3.3.0",
    "use-intl": "catalog:",
    "workflow": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "next": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@virtbase/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
