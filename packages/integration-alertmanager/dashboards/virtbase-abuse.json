        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
