      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{virtbase_type=\"alert.detection_degraded\", alertstate=\"firing\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "alertstate": true
