{
  "uid": "virtbase-abuse",
  "title": "Virtbase \u2014 Abuse Desk",
  "description": "Detection health first, then live signals, then the traffic behind them. Panels read the recording rules and sql_exporter metrics defined in packages/integration-alertmanager/rules/.",
  "tags": [
    "virtbase",
    "abuse",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Detection health \u2014 if any of these are wrong, everything below reads clean",
