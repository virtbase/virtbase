    {
      "type": "timeseries",
      "title": "Throughput",
      "id": 9,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CH}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS time,\n       sumIf(Bytes * SamplingRate, OutIfBoundary = 'external' AND replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr') * 8 / $bucket AS \"out\",\n       -sumIf(Bytes * SamplingRate, InIfBoundary = 'external' AND replaceRegexpOne(toString(DstAddr), '^::ffff:', '') = '$addr') * 8 / $bucket AS \"in (mirrored)\"\nFROM flows\nWHERE $__timeFilter(TimeReceived) AND ((replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr') OR (replaceRegexpOne(toString(DstAddr), '^::ffff:', '') = '$addr'))\nGROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Packet rate",
      "id": 10,
      "datasource": {
