            }
          }
        },
        "overrides": []
      },
      "description": "Compare against throughput. High packets with low bytes is a scan or a flood; the abuse dashboard thresholds on exactly this.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
