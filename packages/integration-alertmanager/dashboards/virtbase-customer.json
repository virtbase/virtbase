      }
    },
    {
      "type": "timeseries",
      "title": "Mean packet size, outbound",
      "id": 11,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS time,\n       sum(Bytes * SamplingRate) / nullIf(sum(Packets * SamplingRate), 0) AS \"bytes/packet\"\nFROM flows WHERE $__timeFilter(TimeReceived) AND OutIfBoundary = 'external' AND replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr' GROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "description": "Under 128 bytes sustained is bare SYNs \u2014 a sweep rather than sessions.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Traffic by network role of the far end",
      "id": 12,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS time,\n       if(DstNetRole = '', 'internet', toString(DstNetRole)) AS series,\n       sum(Bytes * SamplingRate) * 8 / $bucket AS bps\nFROM flows WHERE $__timeFilter(TimeReceived) AND OutIfBoundary = 'external' AND replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr' GROUP BY time, series ORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      },
      "description": "Whether this address talks to the internet, to other customers, or to infrastructure. East-west traffic to another customer is not transit.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connection attempts and whether they were answered",
      "id": 25,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS time,\n       sumIf(Packets * SamplingRate, OutIfBoundary = 'external' AND bitAnd(TCPFlags, 18) = 2) / $bucket AS \"SYN sent\",\n       sumIf(Packets * SamplingRate, InIfBoundary = 'external' AND bitAnd(TCPFlags, 18) = 18) / $bucket AS \"SYN-ACK received\",\n       sumIf(Packets * SamplingRate, OutIfBoundary = 'external' AND TCPFlags = 16) / $bucket AS \"pure ACK sent\"\nFROM flows\nWHERE $__timeFilter(TimeReceived) AND Proto = 6 AND ((replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr') OR (replaceRegexpOne(toString(DstAddr), '^::ffff:', '') = '$addr'))\nGROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The panel that settles a scan accusation. SYNs answered by SYN-ACKs at roughly the same rate means real conversations. SYNs with no answer is scanning. A wall of pure ACKs with few SYNs is a proxy or VPN pulling downloads \u2014 its egress is ACK-dominated, and an IPv6 ACK is 72 bytes, the same as a bare SYN, which is what fooled the size-based detector. Empty until TCPFlags is enabled in Akvorado's schema."
    },
    {
      "type": "timeseries",
      "title": "Answer rate",
      "id": 26,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CH}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS time,\n       sumIf(Packets * SamplingRate, InIfBoundary = 'external' AND bitAnd(TCPFlags, 18) = 18)\n         / nullIf(sumIf(Packets * SamplingRate, OutIfBoundary = 'external' AND bitAnd(TCPFlags, 18) = 2), 0) AS \"answered\"\nFROM flows\nWHERE $__timeFilter(TimeReceived) AND Proto = 6 AND ((replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr') OR (replaceRegexpOne(toString(DstAddr), '^::ffff:', '') = '$addr'))\nGROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
