      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS time,\n       sumIf(Packets * SamplingRate, OutIfBoundary = 'external' AND replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr') / $bucket AS \"out\",\n       -sumIf(Packets * SamplingRate, InIfBoundary = 'external' AND replaceRegexpOne(toString(DstAddr), '^::ffff:', '') = '$addr') / $bucket AS \"in (mirrored)\"\nFROM flows\nWHERE $__timeFilter(TimeReceived) AND ((replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr') OR (replaceRegexpOne(toString(DstAddr), '^::ffff:', '') = '$addr'))\nGROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
