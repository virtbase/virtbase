    {
      "type": "stat",
      "title": "95th percentile OUT",
      "id": 2,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CH}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CH}"
          },
          "editorType": "sql",
          "rawSql": "SELECT quantileExact(0.95)(bps) AS p95 FROM (\n  SELECT toStartOfInterval(TimeReceived, INTERVAL 300 second) AS t,\n         sum(Bytes * SamplingRate) * 8 / 300 AS bps\n  FROM flows WHERE $__timeFilter(TimeReceived) AND OutIfBoundary = 'external' AND replaceRegexpOne(toString(SrcAddr), '^::ffff:', '') = '$addr' GROUP BY t)",
          "format": 0,
          "queryType": "sql",
          "pluginVersion": "4.0.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2,
          "mappings": []
        },
        "overrides": []
      },
      "description": "Same 5-minute-bucket method as the fleet figure, so this address's number is comparable to the transit bill it contributes to.",
      "options": {
        "reduceOptions": {
