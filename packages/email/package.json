{
  "name": "@virtbase/email",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./resend": {
      "import": "./src/resend/index.ts",
      "require": "./src/resend/index.ts"
    },
    "./resend/*": {
      "import": "./src/resend/*.ts",
      "require": "./src/resend/*.ts"
    },
    "./templates/decline-reason": {
      "import": "./src/templates/decline-reason.ts",
      "require": "./src/templates/decline-reason.ts"
    },
    "./templates/*": {
      "import": "./src/templates/*.tsx",
      "require": "./src/templates/*.tsx"
    },
    "./translations": {
      "import": "./src/translations/index.ts",
      "require": "./src/translations/index.ts"
    },
    "./send-via-nodemailer": {
      "import": "./src/send-via-nodemailer.ts",
      "require": "./src/send-via-nodemailer.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "email": "email dev --dir ./src/templates -p 3333",
    "test": "bun --env-file=../../.env.test test --timeout 20000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@virtbase/utils": "workspace:*",
    "nodemailer": "^10.0.1",
    "react-email": "^6.9.5",
    "resend": "^6.26.0",
    "use-intl": "catalog:intl"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@react-email/preview-server": "^5.2.10",
    "@react-email/ui": "^6.9.5",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@virtbase/tsconfig": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  }
}
