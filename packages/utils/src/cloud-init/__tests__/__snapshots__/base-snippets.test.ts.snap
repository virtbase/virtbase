exports[`BASE_SNIPPETS snapshot: freebsd-14.2 1`] = `
"#cloud-config
# Generated by Virtbase - do not edit on the guest, edit the snippets.
# snippets: base-cloud-init, base-guest-agent-freebsd, base-remove-default-users, base-sshd-inline
ssh_pwauth: true
disable_root: false
packages:
  - qemu-guest-agent
runcmd:
  - - sh
    - -c
    - sysrc qemu_guest_agent_enable=YES >/dev/null 2>&1 || true
  - - sh
    - -c
    - service qemu-guest-agent start >/dev/null 2>&1 || true
  - - sh
    - -c
    - for u in almalinux alpine arch centos cloud-user debian ec2-user fedora opc rocky ubuntu; do userdel -f -r "$u" 2>/dev/null || true; done
  - - sh
    - /var/lib/virtbase/cloud-init/base-sshd-inline.sh
write_files:
  - path: /var/lib/virtbase/cloud-init/base-sshd-inline.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      # sshd on these images has no Include for sshd_config.d, so the drop-in written
      # by base-sshd-dropin is never read. Edit the file itself instead, idempotently.
      config=/etc/ssh/sshd_config
      [ -f "$config" ] || exit 0

      set_option() {
        key="$1"
        value="$2"
        if grep -qE "^[#[:space:]]*\${key}[[:space:]]" "$config"; then
          sed -i.bak -E "s|^[#[:space:]]*\${key}[[:space:]].*|\${key} \${value}|" "$config"
        else
          printf '%s %s\\n' "$key" "$value" >> "$config"
        fi
      }

      set_option PermitRootLogin yes
      set_option PasswordAuthentication yes
      set_option MaxAuthTries 20

      service sshd reload 2>/dev/null || true
"
`;
