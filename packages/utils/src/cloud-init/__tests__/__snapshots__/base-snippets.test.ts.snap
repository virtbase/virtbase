// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`BASE_SNIPPETS snapshot: debian-13 1`] = `
"#cloud-config
# Generated by Virtbase - do not edit on the guest, edit the snippets.
# snippets: base-cloud-init, base-guest-agent, base-remove-default-users, base-sshd-dropin
ssh_pwauth: true
disable_root: false
packages:
  - qemu-guest-agent
runcmd:
  - - sh
    - -c
    - systemctl enable --now qemu-guest-agent 2>/dev/null || rc-service qemu-guest-agent start 2>/dev/null || true
  - - sh
    - -c
    - for u in almalinux alpine arch centos cloud-user debian ec2-user fedora opc rocky ubuntu; do userdel -f -r "$u" 2>/dev/null || true; done
  - - sh
    - -c
    - systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || service sshd reload 2>/dev/null || true
write_files:
  - path: /etc/ssh/sshd_config.d/60-virtbase.conf
    permissions: "0644"
    content: |
      PermitRootLogin yes
      PasswordAuthentication yes
      MaxAuthTries 20
"
`;

