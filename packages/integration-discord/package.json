{
  "name": "@virtbase/integration-discord",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "rasterize-emojis": "bun scripts/rasterize-emojis.ts",
    "test": "bun --env-file=../../.env.test test --timeout 20000",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "bun --env-file ../../.env --"
  },
  "dependencies": {
    "@virtbase/db": "workspace:*",
    "@virtbase/integration-sdk": "workspace:*",
    "@virtbase/ports": "workspace:*",
    "@virtbase/validators": "workspace:*",
    "@virtbase/utils": "workspace:*",
    "discord-api-types": "^0.38.55",
    "next-intl": "catalog:intl",
    "tweetnacl": "^1.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@virtbase/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
