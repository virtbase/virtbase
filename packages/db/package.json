{
  "name": "@virtbase/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./test-client": "./src/test-client.ts",
    "./schema": "./src/schema/index.ts",
    "./utils": "./src/utils/index.ts",
    "./queries": "./src/queries/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "db:check": "bun scripts/check-migrations.ts",
    "db:generate": "bun with-env drizzle-kit generate",
    "db:migrate": "bun with-env drizzle-kit migrate",
    "db:push": "bun with-env drizzle-kit push",
    "db:studio": "bun with-env drizzle-kit studio",
    "test": "bun --env-file=../../.env.test test --timeout 20000 --isolate",
    "typecheck": "tsc --noEmit",
    "with-env": "bun --bun --env-file ../../.env --"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@virtbase/utils": "workspace:*",
    "base-x": "^5.0.1",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/ws": "^8.18.2",
    "@virtbase/tsconfig": "workspace:*",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "pg": "^8.23.1",
    "typescript": "catalog:"
  },
  "virtbase": {
    "coverage": {
      "lines": 0.87,
      "functions": 0.15
    }
  }
}
