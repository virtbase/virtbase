# libpve-storage-perl owns Storage.pm and API2/Storage/Status.pm, qemu-server
# owns API2/Qemu.pm. The directory is watched rather than the files, so the
# trigger keeps firing if Proxmox moves a file.
#
# noawait: the packages that write there must not wait for this one, or a patch
# that no longer fits would leave them unconfigured.
interest-noawait /usr/share/perl5/PVE
