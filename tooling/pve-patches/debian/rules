#!/usr/bin/make -f

%:
	dh $@

# CHANGELOG.md ships as documentation; without -X it would be renamed to the
# package changelog, next to debian/changelog.
override_dh_installchangelogs:
	dh_installchangelogs -XCHANGELOG.md

# The timer is enabled and started on install. The service is a oneshot that
# the postinst already runs, so an upgrade does not restart it.
override_dh_installsystemd:
	dh_installsystemd --name=virtbase-pve-repatch --no-restart-after-upgrade
