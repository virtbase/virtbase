[Unit]
Description=Reapply the virtbase-pve-patches Proxmox VE patches
Documentation=man:virtbase-pve-repatch(8)
ConditionPathIsDirectory=/usr/share/perl5/PVE

[Service]
Type=oneshot
ExecStart=/usr/sbin/virtbase-pve-repatch apply
# No Restart=: a patch that no longer fits does not apply on a retry, and the
# failed unit state is what reports it.
