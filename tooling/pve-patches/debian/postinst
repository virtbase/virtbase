#!/bin/sh

set -e

case "$1" in
  configure | triggered)
    # Never fails the transaction: a patch that no longer fits must not leave
    # dpkg half-configured on a hypervisor. virtbase-pve-repatch has already
    # logged the failure and written it to the metrics file.
    virtbase-pve-repatch apply || true
    ;;
  abort-upgrade | abort-remove | abort-deconfigure) ;;
  *)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
