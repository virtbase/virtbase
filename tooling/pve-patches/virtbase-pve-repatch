#!/usr/bin/env bash
#
# Reapplies the patches and publishes their state. Runs from the dpkg file
# trigger, from the daily timer and by hand.
#
# Exits non-zero while any patch is not applied. A patch in state `unknown` no
# longer fits the installed Proxmox version and cannot be reapplied by running
# again; the exit status, the journal and the metrics file report it.

set -euo pipefail

PATCH_SH="${PATCH_SH:-/usr/share/virtbase-pve-patches/patch.sh}"
TEXTFILE_DIR="${TEXTFILE_DIR:-/var/lib/prometheus/node-exporter}"
METRIC_FILE="${METRIC_FILE:-${TEXTFILE_DIR}/virtbase_pve_patches.prom}"

# Exported, so the settings reach patch.sh as well.
if [[ -r /etc/default/virtbase-pve-repatch ]]; then
  set -a
  # shellcheck source=/dev/null
  . /etc/default/virtbase-pve-repatch
  set +a
fi

# syslog is best effort: /dev/log does not exist in a container.
log() {
  echo "virtbase-pve-repatch: $*" >&2
  logger -t virtbase-pve-repatch -- "$*" 2>/dev/null || true
}

# Prints `patch<TAB>state` lines from patch.sh's JSON, without jq, which a stock
# Proxmox node does not ship.
parse_states() {
  local json="${1//\},\{/$'}\n{'}"
  sed -n 's/.*"patch":"\([^"]*\)","state":"\([^"]*\)".*/\1\t\2/p' <<<"${json}"
}

state_to_metric() {
  case "$1" in
    applied) echo 1 ;;
    pending) echo 0 ;;
    *) echo -1 ;;
  esac
}

# Written for the node_exporter textfile collector, and skipped when its
# directory does not exist. The file is replaced atomically, because the
# collector reads it on every scrape.
publish_metrics() {
  local json="$1" tmp patch state
  [[ -d "${TEXTFILE_DIR}" ]] || return 0

  tmp="$(mktemp "${METRIC_FILE}.XXXXXX")"
  {
    echo "# HELP virtbase_pve_patch_state Patch state (1 applied, 0 pending, -1 unknown)."
    echo "# TYPE virtbase_pve_patch_state gauge"
    while IFS=$'\t' read -r patch state; do
      [[ -n "${patch}" ]] || continue
      printf 'virtbase_pve_patch_state{patch="%s"} %s\n' \
        "${patch}" "$(state_to_metric "${state}")"
    done < <(parse_states "${json}")
    echo "# HELP virtbase_pve_patch_last_run_timestamp_seconds When the patches were last checked."
    echo "# TYPE virtbase_pve_patch_last_run_timestamp_seconds gauge"
    echo "virtbase_pve_patch_last_run_timestamp_seconds $(date +%s)"
  } >"${tmp}"
  chmod 0644 "${tmp}"
  mv -f "${tmp}" "${METRIC_FILE}"
}

patches_in_state() {
  parse_states "$1" | awk -F'\t' -v s="$2" '$2 == s { print $1 }' | tr '\n' ' '
}

main() {
  local command="${1:-apply}"
  case "${command}" in
    apply | unapply | status | dry-run-apply | dry-run-unapply) ;;
    *)
      echo "Usage: $(basename "$0") [apply|unapply|status|dry-run-apply|dry-run-unapply]" >&2
      exit 64
      ;;
  esac

  if [[ ! -x "${PATCH_SH}" ]]; then
    log "error: ${PATCH_SH} is missing or not executable"
    exit 1
  fi

  local rc=0
  if [[ "${command}" != status ]]; then
    "${PATCH_SH}" "${command}" || rc=$?
  fi

  # Classified after acting, so the metrics describe the state left behind.
  local json unknown pending
  json="$("${PATCH_SH}" status --json)"
  publish_metrics "${json}"

  unknown="$(patches_in_state "${json}" unknown)"
  if [[ -n "${unknown}" ]]; then
    log "error: these patches do not fit the installed Proxmox version: ${unknown}"
    return 1
  fi

  if [[ "${command}" != unapply ]]; then
    pending="$(patches_in_state "${json}" pending)"
    if [[ -n "${pending}" ]]; then
      log "warning: these patches are not applied: ${pending}"
      return 1
    fi
  fi

  [[ "${rc}" -eq 0 ]] || log "warning: ${PATCH_SH} ${command} exited ${rc}"
  return "${rc}"
}

main "$@"
