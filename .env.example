###############################
###### REQUIRED ENV VARS ######
###############################

# Uncomment for local development
# NODE_ENV="development"
# NEXT_PUBLIC_VERCEL_ENV="development"

NEXT_PUBLIC_APP_NAME=Virtbase

# For local development use virtbase.localhost
# NEXT_PUBLIC_APP_DOMAIN=virtbase.localhost
NEXT_PUBLIC_APP_DOMAIN=virtbase.com

# Generate a random secret here: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET=

# Unwraps per-integration data keys for the configuration store.
# 32 bytes, hex or base64. Generate with: openssl rand -base64 32
#
# Integration credentials — Lexware, PowerDNS, the Discord bot token and public
# key — are no longer read from here. They are configured in the admin console
# at /admin.virtbase.com/integrations and stored encrypted in Postgres. The
# variables that remain below are the ones application code still reads
# directly.
CONFIG_ENCRYPTION_KEY=

# PostgreSQL Database via Neon
DATABASE_URL="postgresql://postgres:password@db.localtest.me:5432/virtbase"

# Upstash Redis – required for Redis caching
# Get your Redis REST URL and Token here: https://upstash.com/docs/redis/overall/getstarted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for email sending
# Get your Resend API Key here: https://resend.com/api-keys
RESEND_API_KEY=
# Optional: Store emails in the database using a webhook
# Create a webhook pointing to /api/resend/webhook with all email events enabled
# RESEND_WEBHOOK_SECRET=

# SMTP configuration (Recommended for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=smtpUser
SMTP_PASSWORD=smtpPassword

# Stripe for payment processing
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Anonpay for cryptocurrency payments (optional)
# If enabled, all of the Anonpay related environment variables must be set.
# NEXT_PUBLIC_STRIPE_ANONPAY_METHOD_ID=
# The ticker of the coin you want to receive. E.g. btc, xmr, eth, etc.
# ANONPAY_TICKER_TO=
# The network of the coin you want to receive. E.g. Mainnet, ERC20, BEP20, etc.
# ANONPAY_NETWORK_TO=
# The address in which you want to receive. E.g. 89Jb5....D1LdB12 for our Monero address
# ANONPAY_ADDRESS=
# Secret for Anonpay webhooks
# ANONPAY_WEBHOOK_SECRET=

# Secret for cron jobs
# Generate a random secret here: https://generate-secret.vercel.app/32
CRON_SECRET=

# noVNC proxy
# See packages/novnc-proxy for more information
NOVNC_PROXY_URL=
NOVNC_PROXY_SECRET=

###############################
###### OPTIONAL ENV VARS ######
###############################

# Vercel AI Gateway API Key
# Learn how to set this up here: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys&title=AI+Gateway+API+Keys
# AI_GATEWAY_API_KEY=

# Used for Discord Login
# Learn how to set this up here: https://better-auth.com/docs/authentication/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Used for GitHub Login
# Learn how to set this up here: https://better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Used for Google Login
# Learn how to set this up here: https://better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry for error tracking
# Learn how to set this up here: https://docs.sentry.io/platforms/javascript/guides/nextjs/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
# Optional: Send Content-Security-Policy violations to Sentry
# NEXT_PUBLIC_SENTRY_CSP_REPORT_URI=

# --- Abuse mailbox ---------------------------------------------------------
# The domain the abuse desk receives on and sends as. Needs its own MX in
# Resend, so it cannot be a domain whose mail already goes somewhere else -
# use a subdomain (abuse.virtbase.com) when the apex has MX records already.
# Defaults to NEXT_PUBLIC_APP_DOMAIN, which is usually the wrong one.
ABUSE_MAILBOX_DOMAIN=
# Signs the per-case address tag in `abuse+<number>.<tag>@`. Without it the
# address is guessable, so the mailbox refuses to route by tag and falls back
# to the subject reference. Falls back to CONFIG_ENCRYPTION_KEY.
# Generate with `openssl rand -hex 32`.
ABUSE_MAILBOX_SECRET=
