###############################
###### REQUIRED ENV VARS ######
###############################

# The shared key for the AES-256-GCM encrypted payload messages minted by the
# web app. It must match NOVNC_PROXY_SECRET there, or every console is refused.
# 64 hex characters (256 bits); the proxy refuses to start without one.
# Generate one with: openssl rand -hex 32
NOVNC_PROXY_SECRET=""

###############################
###### OPTIONAL ENV VARS ######
###############################

# The port on which the HTTP and WSS server listens.
# Default: 8443
PORT="8443"

# A PEM bundle of CA certificates to trust in addition to Bun's bundled roots,
# for Proxmox nodes whose certificate comes from a private CA - such as the
# local cluster's tooling/proxmox-cluster/pve-root-ca.pem.
# NODE_EXTRA_CA_CERTS="/certs/pve-root-ca.pem"
