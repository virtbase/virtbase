###############################
###### REQUIRED ENV VARS ######
###############################

# The port on which the HTTP and WSS Server are listening on
# Default: 8443
PORT="8443"

# The shared key for the AES-256-GCM encrypted payload messages minted by the
# web app. It must match NOVNC_PROXY_SECRET there, or every console is refused.
# This must be in HEX format for 256 bits (64 hex characters)
# Generate one with: openssl rand -hex 32
NOVNC_PROXY_SECRET=""