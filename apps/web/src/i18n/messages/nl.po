#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "lYlalx"
msgid "AbuseIPDB"
msgstr "AbuseIPDB"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "utGnBr"
msgid "Sweeps our own address ranges for reports filed against them, and looks up the reputation of a single address."
msgstr "Doorzoekt onze eigen adresreeksen op meldingen die ertegen zijn ingediend, en zoekt de reputatie van één adres op."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "cZ2pIN"
msgid "Confidence threshold"
msgstr "Betrouwbaarheidsdrempel"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "KhnDzH"
msgid "Below this score, a reported address is ignored."
msgstr "Onder deze score wordt een gemeld adres genegeerd."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "osZi7I"
msgid "Report age"
msgstr "Leeftijd van meldingen"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "5hDWuX"
msgid "How far back the provider should look, in days."
msgstr "Hoe ver de provider moet terugkijken, in dagen."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "6ijXWp"
msgid "Block size"
msgstr "Blokgrootte"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "BVpDyn"
msgid "The smallest block a sweep asks about. A free key is limited to /24."
msgstr "Het kleinste blok waar een scan naar vraagt. Een gratis sleutel is beperkt tot /24."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "1O6nNu"
msgid "Calls per run"
msgstr "Aanroepen per run"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "O3o6j3"
msgid "Provider calls one sweep may make. Four per hour fits inside a free key's daily allowance."
msgstr "Aanroepen bij de provider die één scan mag doen. Vier per uur past binnen de daglimiet van een gratis sleutel."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "4aIITL"
msgid "Look up categories"
msgstr "Categorieën opzoeken"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "jwnZSk"
msgid "Spends an extra call per finding so a case says what it was reported for instead of “other”."
msgstr "Kost een extra aanroep per bevinding, zodat een zaak vermeldt waarvoor er is gemeld in plaats van ‘overig’."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "GDitI5"
msgid "Allow reporting back"
msgstr "Terugmelden toestaan"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "kms48f"
msgid "Lets an operator publish a report when a case is confirmed. Never automatic."
msgstr "Laat een operator een melding publiceren zodra een zaak bevestigd is. Nooit automatisch."

#: ../../packages/integration-abuseipdb/src/localize.ts
#: ../../packages/integration-lexware/src/localize.ts
#: ../../packages/integration-powerdns/src/localize.ts
msgctxt "KTNoOq"
msgid "API key"
msgstr "API-sleutel"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "EAEEtM"
msgid "Sent as the Key header."
msgstr "Wordt verstuurd als de Key-header."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "IbOv8i"
msgid "Alertmanager"
msgstr "Alertmanager"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "UUYX3B"
msgid "Receives alerts from Prometheus Alertmanager or Grafana and turns them into abuse cases and operator notifications."
msgstr "Ontvangt alerts van Prometheus Alertmanager of Grafana en maakt er misbruikzaken en operatormeldingen van."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "_uIIli"
msgid "Payload format"
msgstr "Payload-formaat"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "zVsF9H"
msgid "Which shape the sender speaks. Grafana sends the Alertmanager shape with extras."
msgstr "Welk formaat de afzender spreekt. Grafana stuurt het Alertmanager-formaat met extra's."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "rgPqeB"
msgid "Default severity"
msgstr "Standaard ernst"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "GtLzvO"
msgid "Used when an alert carries no severity label."
msgstr "Wordt gebruikt als een alert geen severity-label heeft."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "2Ij319"
msgid "Ingest token"
msgstr "Ingest-token"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "ChfUsD"
msgid "Sent as an Authorization bearer token. Generate one with `openssl rand -hex 32`."
msgstr "Wordt verstuurd als Authorization-bearertoken. Genereer er een met `openssl rand -hex 32`."

