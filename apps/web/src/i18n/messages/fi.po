msgctxt "discord-integration.q6DHpk"
msgid "Rule #{pos} will be removed. If it was the rule allowing your own access, you may lock yourself out."
msgstr "Sääntö #{pos} poistetaan. Jos se oli sääntö, joka salli oman pääsysi, saatat lukita itsesi ulos."

#: ../../packages/integration-discord/src/features/firewall/index.ts
