msgstr "Valitse poistettava sääntö"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.Nqtcq5"
msgid "Default policies"
msgstr "Oletuskäytännöt"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.gzM1em"
msgid "Add rule"
msgstr "Lisää sääntö"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.MHRs1u"
msgid "Add firewall rule"
msgstr "Lisää palomuurisääntö"

