msgctxt "discord-integration.ATw7BX"
msgid "ACCEPT, DROP or REJECT. Added at the top, so it is checked first."
msgstr "ACCEPT, DROP tai REJECT. Lisätään alkuun, joten se tarkistetaan ensimmäisenä."

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.0QLzxo"
msgid "Protocol"
msgstr "pöytäkirja"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.8FY7Cm"
msgid "For example tcp, udp or icmp."
msgstr "Esimerkiksi tcp, udp tai icmp."

