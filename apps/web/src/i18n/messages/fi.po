msgctxt "discord-integration.Bwqhmd"
msgid "Firewall"
msgstr "Palomuuri"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.WybD0S"
msgid "The firewall is always on. These are the default actions applied to anything no rule below matches."
msgstr "Palomuuri on aina päällä. Nämä ovat oletustoiminnot kaikelle, mihin mikään alla olevista säännöistä ei osu."

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.2Cuff9"
msgid "Incoming: **{incoming}** · Outgoing: **{outgoing}**"
msgstr "Saapuva: **{incoming}** · Lähtevä: **{outgoing}**"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.0EJN6x"
msgid "Showing {shown} of {total} rules. Manage the rest in the portal."
msgstr "Näytetään {shown}/{total} sääntöä. Hallitse loput asiakasportaalissa."

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.ue2UOa"
msgid "No rules"
msgstr "Ei sääntöjä"

#: ../../packages/integration-discord/src/features/firewall/index.ts
msgctxt "discord-integration.7SSws8"
msgid "This server has no firewall rules. With the firewall on and no rules, the default policies above decide everything."
msgstr "Tällä palvelimella ei ole palomuurisääntöjä. Kun palomuuri on päällä eikä sääntöjä ole, kaiken ratkaisevat yksin yllä olevat oletuskäytännöt."

#: ../../packages/integration-discord/src/features/firewall/index.ts
