msgid "**{name}** is mounted. Reboot the server to boot from it, or unmount it to go back to the disk."
msgstr "**{name}** on liitetty. Käynnistä palvelin uudelleen käynnistääksesi siitä, tai irrota se palataksesi levylle."

#: ../../packages/integration-discord/src/features/lifecycle/index.ts
msgctxt "discord-integration.BWwrKU"
msgid "You have no installer images ready. Add one in the customer portal, then mount it here."
msgstr "Sinulla ei ole asennuslevykuvia valmiina. Lisää sellainen asiakasportaalissa ja liitä se sitten tässä."

#: ../../packages/integration-discord/src/features/lifecycle/index.ts
msgctxt "discord-integration.U7qHPh"
msgid "Nothing is mounted. Mounting an image attaches it as a virtual disc; reboot the server afterwards to boot from it."
msgstr "Mitään ei ole liitetty. Liitetty levykuva kytketään virtuaalisena asemana; käynnistä palvelin sen jälkeen uudelleen käynnistääksesi siitä."

#: ../../packages/integration-discord/src/features/lifecycle/index.ts
msgctxt "discord-integration.L2ufbn"
msgid "Expires {when}"
msgstr "Vanhenee {when}"

#: ../../packages/integration-discord/src/features/lifecycle/index.ts
