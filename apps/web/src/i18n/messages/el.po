#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "lYlalx"
msgid "AbuseIPDB"
msgstr "AbuseIPDB"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "utGnBr"
msgid "Sweeps our own address ranges for reports filed against them, and looks up the reputation of a single address."
msgstr "Σαρώνει τα δικά μας εύρη διευθύνσεων για αναφορές εναντίον τους και ελέγχει τη φήμη μιας μεμονωμένης διεύθυνσης."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "cZ2pIN"
msgid "Confidence threshold"
msgstr "Κατώφλι βεβαιότητας"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "KhnDzH"
msgid "Below this score, a reported address is ignored."
msgstr "Κάτω από αυτή τη βαθμολογία, μια αναφερθείσα διεύθυνση αγνοείται."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "osZi7I"
msgid "Report age"
msgstr "Ηλικία αναφορών"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "5hDWuX"
msgid "How far back the provider should look, in days."
msgstr "Πόσο πίσω πρέπει να κοιτάξει ο πάροχος, σε ημέρες."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "6ijXWp"
msgid "Block size"
msgstr "Μέγεθος μπλοκ"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "BVpDyn"
msgid "The smallest block a sweep asks about. A free key is limited to /24."
msgstr "Το μικρότερο μπλοκ που ζητά μια σάρωση. Ένα δωρεάν κλειδί περιορίζεται σε /24."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "1O6nNu"
msgid "Calls per run"
msgstr "Κλήσεις ανά εκτέλεση"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "O3o6j3"
msgid "Provider calls one sweep may make. Four per hour fits inside a free key's daily allowance."
msgstr "Κλήσεις προς τον πάροχο που μπορεί να κάνει μία σάρωση. Τέσσερις την ώρα χωρούν στο ημερήσιο όριο ενός δωρεάν κλειδιού."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "4aIITL"
msgid "Look up categories"
msgstr "Ανάκτηση κατηγοριών"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "jwnZSk"
msgid "Spends an extra call per finding so a case says what it was reported for instead of “other”."
msgstr "Κοστίζει μία επιπλέον κλήση ανά εύρημα, ώστε μια υπόθεση να λέει για ποιο λόγο αναφέρθηκε αντί για «άλλο»."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "GDitI5"
msgid "Allow reporting back"
msgstr "Να επιτρέπεται αναφορά προς τα πίσω"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "kms48f"
msgid "Lets an operator publish a report when a case is confirmed. Never automatic."
msgstr "Επιτρέπει σε έναν χειριστή να δημοσιεύσει μια αναφορά όταν μια υπόθεση επιβεβαιωθεί. Ποτέ αυτόματα."

#: ../../packages/integration-abuseipdb/src/localize.ts
#: ../../packages/integration-lexware/src/localize.ts
#: ../../packages/integration-powerdns/src/localize.ts
msgctxt "KTNoOq"
msgid "API key"
msgstr "Κλειδί API"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "EAEEtM"
msgid "Sent as the Key header."
msgstr "Αποστέλλεται ως κεφαλίδα Key."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "IbOv8i"
msgid "Alertmanager"
msgstr "Alertmanager"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "UUYX3B"
msgid "Receives alerts from Prometheus Alertmanager or Grafana and turns them into abuse cases and operator notifications."
msgstr "Λαμβάνει ειδοποιήσεις από το Prometheus Alertmanager ή το Grafana και τις μετατρέπει σε υποθέσεις κατάχρησης και ειδοποιήσεις χειριστών."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "_uIIli"
msgid "Payload format"
msgstr "Μορφή payload"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "zVsF9H"
msgid "Which shape the sender speaks. Grafana sends the Alertmanager shape with extras."
msgstr "Ποια μορφή μιλάει ο αποστολέας. Το Grafana στέλνει τη μορφή του Alertmanager με επιπλέον πεδία."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "rgPqeB"
msgid "Default severity"
msgstr "Προεπιλεγμένη σοβαρότητα"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "GtLzvO"
msgid "Used when an alert carries no severity label."
msgstr "Χρησιμοποιείται όταν μια ειδοποίηση δεν έχει ετικέτα σοβαρότητας."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "2Ij319"
msgid "Ingest token"
msgstr "Token εισαγωγής"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "ChfUsD"
msgid "Sent as an Authorization bearer token. Generate one with `openssl rand -hex 32`."
msgstr "Αποστέλλεται ως Bearer token στην κεφαλίδα Authorization. Δημιούργησε ένα με `openssl rand -hex 32`."

