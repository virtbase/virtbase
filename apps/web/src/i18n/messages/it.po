#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "lYlalx"
msgid "AbuseIPDB"
msgstr ""

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "utGnBr"
msgid "Sweeps our own address ranges for reports filed against them, and looks up the reputation of a single address."
msgstr "Analizza i nostri intervalli di indirizzi alla ricerca di segnalazioni a loro carico e verifica la reputazione di un singolo indirizzo."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "cZ2pIN"
msgid "Confidence threshold"
msgstr "Soglia di attendibilità"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "KhnDzH"
msgid "Below this score, a reported address is ignored."
msgstr "Sotto questo punteggio un indirizzo segnalato viene ignorato."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "osZi7I"
msgid "Report age"
msgstr "Età delle segnalazioni"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "5hDWuX"
msgid "How far back the provider should look, in days."
msgstr "Quanto indietro deve guardare il provider, in giorni."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "6ijXWp"
msgid "Block size"
msgstr "Dimensione del blocco"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "BVpDyn"
msgid "The smallest block a sweep asks about. A free key is limited to /24."
msgstr "Il blocco più piccolo che una scansione può richiedere. Una chiave gratuita è limitata a /24."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "1O6nNu"
msgid "Calls per run"
msgstr "Chiamate per esecuzione"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "O3o6j3"
msgid "Provider calls one sweep may make. Four per hour fits inside a free key's daily allowance."
msgstr "Chiamate al provider che una scansione può fare. Quattro all'ora rientrano nel limite giornaliero di una chiave gratuita."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "4aIITL"
msgid "Look up categories"
msgstr "Recupera le categorie"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "jwnZSk"
msgid "Spends an extra call per finding so a case says what it was reported for instead of “other”."
msgstr "Costa una chiamata in più per ogni riscontro, così un caso indica il motivo della segnalazione invece di «altro»."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "GDitI5"
msgid "Allow reporting back"
msgstr "Consenti di segnalare a tua volta"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "kms48f"
msgid "Lets an operator publish a report when a case is confirmed. Never automatic."
msgstr "Permette a un operatore di pubblicare una segnalazione quando un caso è confermato. Mai in automatico."

#: ../../packages/integration-abuseipdb/src/localize.ts
#: ../../packages/integration-lexware/src/localize.ts
#: ../../packages/integration-powerdns/src/localize.ts
msgctxt "KTNoOq"
msgid "API key"
msgstr "Chiave API"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "EAEEtM"
msgid "Sent as the Key header."
msgstr "Inviata nell'header Key."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "IbOv8i"
msgid "Alertmanager"
msgstr ""

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "UUYX3B"
msgid "Receives alerts from Prometheus Alertmanager or Grafana and turns them into abuse cases and operator notifications."
msgstr "Riceve gli alert da Prometheus Alertmanager o Grafana e li trasforma in casi di abuso e notifiche per gli operatori."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "_uIIli"
msgid "Payload format"
msgstr "Formato del payload"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "zVsF9H"
msgid "Which shape the sender speaks. Grafana sends the Alertmanager shape with extras."
msgstr "Quale formato parla il mittente. Grafana invia il formato Alertmanager con delle aggiunte."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "rgPqeB"
msgid "Default severity"
msgstr "Gravità predefinita"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "GtLzvO"
msgid "Used when an alert carries no severity label."
msgstr "Usata quando un alert non porta alcuna etichetta di gravità."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "2Ij319"
msgid "Ingest token"
msgstr "Token di ingest"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "ChfUsD"
msgid "Sent as an Authorization bearer token. Generate one with `openssl rand -hex 32`."
msgstr "Inviato come token Bearer nell'header Authorization. Generane uno con `openssl rand -hex 32`."

