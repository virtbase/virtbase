#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "lYlalx"
msgid "AbuseIPDB"
msgstr ""

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "utGnBr"
msgid "Sweeps our own address ranges for reports filed against them, and looks up the reputation of a single address."
msgstr "Przeczesuje nasze własne zakresy adresów w poszukiwaniu zgłoszeń przeciwko nim i sprawdza reputację pojedynczego adresu."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "cZ2pIN"
msgid "Confidence threshold"
msgstr "Próg pewności"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "KhnDzH"
msgid "Below this score, a reported address is ignored."
msgstr "Poniżej tej oceny zgłoszony adres jest pomijany."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "osZi7I"
msgid "Report age"
msgstr "Wiek zgłoszeń"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "5hDWuX"
msgid "How far back the provider should look, in days."
msgstr "Jak daleko wstecz ma sięgać dostawca, w dniach."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "6ijXWp"
msgid "Block size"
msgstr "Rozmiar bloku"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "BVpDyn"
msgid "The smallest block a sweep asks about. A free key is limited to /24."
msgstr "Najmniejszy blok, o który pyta przebieg. Darmowy klucz jest ograniczony do /24."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "1O6nNu"
msgid "Calls per run"
msgstr "Wywołania na przebieg"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "O3o6j3"
msgid "Provider calls one sweep may make. Four per hour fits inside a free key's daily allowance."
msgstr "Wywołania do dostawcy, które może wykonać jeden przebieg. Cztery na godzinę mieszczą się w dziennym limicie darmowego klucza."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "4aIITL"
msgid "Look up categories"
msgstr "Pobieraj kategorie"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "jwnZSk"
msgid "Spends an extra call per finding so a case says what it was reported for instead of “other”."
msgstr "Kosztuje jedno dodatkowe wywołanie na każde znalezisko, ale dzięki temu sprawa podaje powód zgłoszenia zamiast „inne”."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "GDitI5"
msgid "Allow reporting back"
msgstr "Zezwól na zgłaszanie zwrotne"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "kms48f"
msgid "Lets an operator publish a report when a case is confirmed. Never automatic."
msgstr "Pozwala operatorowi opublikować zgłoszenie, gdy sprawa zostanie potwierdzona. Nigdy automatycznie."

#: ../../packages/integration-abuseipdb/src/localize.ts
#: ../../packages/integration-lexware/src/localize.ts
#: ../../packages/integration-powerdns/src/localize.ts
msgctxt "KTNoOq"
msgid "API key"
msgstr "Klucz API"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "EAEEtM"
msgid "Sent as the Key header."
msgstr "Wysyłany w nagłówku Key."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "IbOv8i"
msgid "Alertmanager"
msgstr ""

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "UUYX3B"
msgid "Receives alerts from Prometheus Alertmanager or Grafana and turns them into abuse cases and operator notifications."
msgstr "Odbiera alerty z Prometheus Alertmanagera lub Grafany i zamienia je w sprawy nadużyć oraz powiadomienia dla operatorów."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "_uIIli"
msgid "Payload format"
msgstr "Format ładunku"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "zVsF9H"
msgid "Which shape the sender speaks. Grafana sends the Alertmanager shape with extras."
msgstr "Jakim formatem mówi nadawca. Grafana wysyła format Alertmanagera z dodatkami."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "rgPqeB"
msgid "Default severity"
msgstr "Domyślna ważność"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "GtLzvO"
msgid "Used when an alert carries no severity label."
msgstr "Używana, gdy alert nie ma etykiety ważności."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "2Ij319"
msgid "Ingest token"
msgstr "Token przyjmowania"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "ChfUsD"
msgid "Sent as an Authorization bearer token. Generate one with `openssl rand -hex 32`."
msgstr "Wysyłany jako token Bearer w nagłówku Authorization. Wygeneruj go poleceniem `openssl rand -hex 32`."

