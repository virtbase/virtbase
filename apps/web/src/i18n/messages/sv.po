#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "lYlalx"
msgid "AbuseIPDB"
msgstr "AbuseIPDB"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "utGnBr"
msgid "Sweeps our own address ranges for reports filed against them, and looks up the reputation of a single address."
msgstr "Genomsöker våra egna adressintervall efter anmälningar mot dem, och slår upp anseendet för en enskild adress."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "cZ2pIN"
msgid "Confidence threshold"
msgstr "Konfidenströskel"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "KhnDzH"
msgid "Below this score, a reported address is ignored."
msgstr "Under det här värdet ignoreras en anmäld adress."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "osZi7I"
msgid "Report age"
msgstr "Anmälningarnas ålder"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "5hDWuX"
msgid "How far back the provider should look, in days."
msgstr "Hur långt tillbaka leverantören ska titta, i dagar."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "6ijXWp"
msgid "Block size"
msgstr "Blockstorlek"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "BVpDyn"
msgid "The smallest block a sweep asks about. A free key is limited to /24."
msgstr "Det minsta block en svepning frågar efter. En gratisnyckel är begränsad till /24."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "1O6nNu"
msgid "Calls per run"
msgstr "Anrop per körning"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "O3o6j3"
msgid "Provider calls one sweep may make. Four per hour fits inside a free key's daily allowance."
msgstr "Anrop mot leverantören som en svepning får göra. Fyra i timmen ryms i dagskvoten för en gratisnyckel."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "4aIITL"
msgid "Look up categories"
msgstr "Hämta kategorier"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "jwnZSk"
msgid "Spends an extra call per finding so a case says what it was reported for instead of “other”."
msgstr "Kostar ett extra anrop per träff, men då anger ärendet vad som anmälts i stället för ”övrigt”."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "GDitI5"
msgid "Allow reporting back"
msgstr "Tillåt anmälan tillbaka"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "kms48f"
msgid "Lets an operator publish a report when a case is confirmed. Never automatic."
msgstr "Låter en operatör publicera en anmälan när ett ärende är bekräftat. Aldrig automatiskt."

#: ../../packages/integration-abuseipdb/src/localize.ts
#: ../../packages/integration-lexware/src/localize.ts
#: ../../packages/integration-powerdns/src/localize.ts
msgctxt "KTNoOq"
msgid "API key"
msgstr "API-nyckel"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "EAEEtM"
msgid "Sent as the Key header."
msgstr "Skickas som Key-huvudet."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "IbOv8i"
msgid "Alertmanager"
msgstr "Alertmanager"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "UUYX3B"
msgid "Receives alerts from Prometheus Alertmanager or Grafana and turns them into abuse cases and operator notifications."
msgstr "Tar emot larm från Prometheus Alertmanager eller Grafana och gör om dem till missbruksärenden och operatörsaviseringar."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "_uIIli"
msgid "Payload format"
msgstr "Payload-format"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "zVsF9H"
msgid "Which shape the sender speaks. Grafana sends the Alertmanager shape with extras."
msgstr "Vilket format avsändaren talar. Grafana skickar Alertmanager-formatet med tillägg."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "rgPqeB"
msgid "Default severity"
msgstr "Förvald allvarlighetsgrad"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "GtLzvO"
msgid "Used when an alert carries no severity label."
msgstr "Används när ett larm saknar allvarlighetsetikett."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "2Ij319"
msgid "Ingest token"
msgstr "Ingest-token"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "ChfUsD"
msgid "Sent as an Authorization bearer token. Generate one with `openssl rand -hex 32`."
msgstr "Skickas som Bearer-token i Authorization-huvudet. Generera en med `openssl rand -hex 32`."

