#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "lYlalx"
msgid "AbuseIPDB"
msgstr "AbuseIPDB"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "utGnBr"
msgid "Sweeps our own address ranges for reports filed against them, and looks up the reputation of a single address."
msgstr "Durchsucht unsere eigenen Adressbereiche nach Meldungen gegen sie und schlägt die Reputation einer einzelnen Adresse nach."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "cZ2pIN"
msgid "Confidence threshold"
msgstr "Konfidenzschwelle"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "KhnDzH"
msgid "Below this score, a reported address is ignored."
msgstr "Unterhalb dieses Werts wird eine gemeldete Adresse ignoriert."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "osZi7I"
msgid "Report age"
msgstr "Meldungsalter"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "5hDWuX"
msgid "How far back the provider should look, in days."
msgstr "Wie weit der Anbieter zurückschauen soll, in Tagen."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "6ijXWp"
msgid "Block size"
msgstr "Blockgröße"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "BVpDyn"
msgid "The smallest block a sweep asks about. A free key is limited to /24."
msgstr "Der kleinste Block, den ein Durchlauf abfragt. Ein kostenloser Key ist auf /24 begrenzt."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "1O6nNu"
msgid "Calls per run"
msgstr "Aufrufe pro Durchlauf"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "O3o6j3"
msgid "Provider calls one sweep may make. Four per hour fits inside a free key's daily allowance."
msgstr "Anbieter-Aufrufe, die ein Durchlauf machen darf. Vier pro Stunde bleiben im Tageslimit eines kostenlosen Keys."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "4aIITL"
msgid "Look up categories"
msgstr "Kategorien nachschlagen"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "jwnZSk"
msgid "Spends an extra call per finding so a case says what it was reported for instead of “other”."
msgstr "Kostet einen zusätzlichen Aufruf pro Fund, dafür nennt ein Fall den Meldegrund statt „Sonstiges“."

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "GDitI5"
msgid "Allow reporting back"
msgstr "Rückmeldung erlauben"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "kms48f"
msgid "Lets an operator publish a report when a case is confirmed. Never automatic."
msgstr "Erlaubt einem Operator, bei einem bestätigten Fall eine Meldung zu veröffentlichen. Nie automatisch."

#: ../../packages/integration-abuseipdb/src/localize.ts
#: ../../packages/integration-lexware/src/localize.ts
#: ../../packages/integration-powerdns/src/localize.ts
msgctxt "KTNoOq"
msgid "API key"
msgstr "API-Schlüssel"

#: ../../packages/integration-abuseipdb/src/localize.ts
msgctxt "EAEEtM"
msgid "Sent as the Key header."
msgstr "Wird als Key-Header gesendet."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "IbOv8i"
msgid "Alertmanager"
msgstr "Alertmanager"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "UUYX3B"
msgid "Receives alerts from Prometheus Alertmanager or Grafana and turns them into abuse cases and operator notifications."
msgstr "Empfängt Alerts von Prometheus Alertmanager oder Grafana und macht daraus Missbrauchsfälle und Operator-Benachrichtigungen."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "_uIIli"
msgid "Payload format"
msgstr "Payload-Format"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "zVsF9H"
msgid "Which shape the sender speaks. Grafana sends the Alertmanager shape with extras."
msgstr "Welches Format der Absender spricht. Grafana sendet das Alertmanager-Format mit Zusätzen."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "rgPqeB"
msgid "Default severity"
msgstr "Standard-Schweregrad"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "GtLzvO"
msgid "Used when an alert carries no severity label."
msgstr "Wird verwendet, wenn ein Alert kein Severity-Label trägt."

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "2Ij319"
msgid "Ingest token"
msgstr "Ingest-Token"

#: ../../packages/integration-alertmanager/src/localize.ts
msgctxt "ChfUsD"
msgid "Sent as an Authorization bearer token. Generate one with `openssl rand -hex 32`."
msgstr "Wird als Authorization-Bearer-Token gesendet. Mit `openssl rand -hex 32` erzeugen."

