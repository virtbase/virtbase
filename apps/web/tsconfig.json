{
  "extends": ["@virtbase/tsconfig/nextjs.json", "@virtbase/tsconfig/bun.json"],
  "compilerOptions": {
    "paths": {
      "fdx-source/*": ["./.source/*"],
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "workflow"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    ".source",
    "src/app/.well-known"
  ]
}
