    "@scalar/api-reference-react": "0.9.79",
    "@sentry/nextjs": "catalog:sentry",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@trpc/client": "catalog:trpc",
    "@trpc/server": "catalog:trpc",
    "@trpc/tanstack-react-query": "catalog:trpc",
    "@uiw/react-codemirror": "^4.25.12",
    "@virtbase/api": "workspace:*",
    "@virtbase/auth": "workspace:*",
    "@virtbase/content": "workspace:*",
    "@virtbase/db": "workspace:*",
    "@virtbase/email": "workspace:*",
    "@virtbase/integration-anonpay": "workspace:*",
    "@virtbase/integration-sdk": "workspace:*",
    "@virtbase/integration-stripe": "workspace:*",
    "@virtbase/ui": "workspace:*",
    "@virtbase/utils": "workspace:*",
    "@virtbase/validators": "workspace:*",
    "better-auth": "catalog:auth",
    "canvas-confetti": "^1.9.4",
    "fumadocs-core": "^16.17.1",
