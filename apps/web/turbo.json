{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "src/app/.well-known/workflow/**",
        ".source/**"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"]
    }
  }
}
