{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "src/app/.well-known/workflow/**",
        ".source/**",
        "public/*/legal/*.pdf"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"]
    }
  }
}
